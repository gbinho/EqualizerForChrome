{
  "manifest_version": 3,
  "name": "Equalizador de Som",
  "short_name": "Equalizador",
  "version": "1.0.0",
  "description": "Equalizador de 10 bandas para qualquer aba: SoundCloud, YouTube e o que mais estiver tocando.",
  "homepage_url": "https://github.com/gbinho/EqualizerForChrome",
  "minimum_chrome_version": "124",
  "permissions": ["tabCapture", "offscreen", "storage", "activeTab"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'none'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Equalizador",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
